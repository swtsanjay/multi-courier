{
  "info": {
    "_postman_id": "9b8d0bd0-f2f9-4f37-91db-f1534b7a837f",
    "name": "Multi Courier",
    "description": "Complete test collection for the Multi Courier TypeScript API. Run Register and Login first, then test couriers, single orders, bulk orders, tracking, cancellation, token refresh, and logout. Mock Courier requests do not require external courier credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": "ORDER-10001"
    },
    {
      "key": "awbNumber",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sanjay Yadav\",\n  \"email\": \"sanjay@example.com\",\n  \"password\": \"Sanjay@1234\",\n  \"phone\": \"8826648669\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Creates a user. Change the email before rerunning if the user already exists."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.data.access_token);",
                  "pm.collectionVariables.set('refreshToken', response.data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sanjay@example.com\",\n  \"password\": \"Sanjay@1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token refreshed', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', response.data.access_token);",
                  "pm.collectionVariables.set('refreshToken', response.data.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            },
            "description": "Rotates the current refresh token and automatically saves the new token pair."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout succeeded', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.collectionVariables.unset('accessToken');",
                  "pm.collectionVariables.unset('refreshToken');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes the current refresh token and clears saved collection tokens."
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Track Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tracking refreshed successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.shipment.trackingHistory).to.be.an('array').that.is.not.empty;"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/track",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "track"]
            },
            "description": "Refreshes tracking through the selected courier and returns the complete persisted timeline."
          }
        },
        {
          "name": "List Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Orders fetched successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.orders).to.be.an('array');",
                  "pm.expect(response.data.pagination).to.be.an('object');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?page=1&limit=20&status=CREATED&courier_partner=mock_courier",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "CREATED" },
                { "key": "courier_partner", "value": "mock_courier" }
              ]
            },
            "description": "Lists the authenticated user's orders with pagination and optional shipment-status/courier filters."
          }
        },
        {
          "name": "Get Order Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order fetched successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.order.orderId).to.eql(pm.collectionVariables.get('orderId'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}"]
            },
            "description": "Returns one order and its shipment details for the authenticated user."
          }
        },
        {
          "name": "Create Mock Courier Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order created or replayed', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.order.shipment.awbNumber).to.be.a('string');",
                  "pm.collectionVariables.set('awbNumber', response.data.order.shipment.awbNumber);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"{{orderId}}\",\n  \"courier_partner\": \"mock_courier\",\n  \"service_type\": \"surface\",\n  \"payment_mode\": \"PREPAID\",\n  \"declared_value\": 1500,\n  \"parcel\": {\n    \"weight_kg\": 1.5,\n    \"length_cm\": 20,\n    \"breadth_cm\": 15,\n    \"height_cm\": 10\n  },\n  \"shipper\": {\n    \"name\": \"Delhi Warehouse\"\n  },\n  \"consignee\": {\n    \"name\": \"Test Customer\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"]
            },
            "description": "Creates a shipment through Mock Courier. Sending the same orderId again tests idempotency and returns replayed=true."
          }
        },
        {
          "name": "Create Bulk Mock Courier Orders",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Bulk processing completed', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.total).to.eql(2);",
                  "pm.expect(response.data.results).to.be.an('array').with.lengthOf(2);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"order_id\": \"BULK-ORDER-10001\",\n    \"courier_partner\": \"mock_courier\",\n    \"service_type\": \"surface\",\n    \"payment_mode\": \"PREPAID\",\n    \"declared_value\": 500,\n    \"parcel\": { \"weight_kg\": 1 },\n    \"shipper\": { \"name\": \"Delhi Warehouse\" },\n    \"consignee\": { \"name\": \"Customer One\" }\n  },\n  {\n    \"order_id\": \"BULK-ORDER-10002\",\n    \"courier_partner\": \"mock_courier\",\n    \"service_type\": \"surface\",\n    \"payment_mode\": \"COD\",\n    \"declared_value\": 750,\n    \"parcel\": { \"weight_kg\": 1.5 },\n    \"shipper\": { \"name\": \"Delhi Warehouse\" },\n    \"consignee\": { \"name\": \"Customer Two\" }\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "bulk"]
            },
            "description": "Creates between 1 and 100 orders. Each order is processed independently and returns its own result."
          }
        },
        {
          "name": "Cancel Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Shipment cancelled successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.shipment.status).to.eql('CANCELLED');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "{{orderId}}", "cancel"]
            },
            "description": "Cancels a shipment. Repeating the request returns replayed=true without calling the courier again."
          }
        }
      ]
    },
    {
      "name": "Couriers",
      "item": [
        {
          "name": "List Couriers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Couriers fetched successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.expect(response.success).to.eql(true);",
                  "pm.expect(response.data.couriers).to.be.an('array');"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/couriers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "couriers"]
            },
            "description": "Lists courier partners, adapter availability, configuration state, and supported capabilities."
          }
        }
      ]
    }
  ]
}
